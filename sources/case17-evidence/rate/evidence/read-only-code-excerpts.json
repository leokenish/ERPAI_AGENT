          {
            "line": 121,
            "text": "    FROM zthrbs01"
          },
          {
            "line": 122,
            "text": "      FOR ALL ENTRIES IN lt_pa0001"
          },
          {
            "line": 123,
            "text": "   WHERE pernr = lt_pa0001-pernr"
          },
          {
            "line": 124,
            "text": "     AND state = '3'"
          },
          {
            "line": 125,
            "text": "     AND zdend =  p_frdat"
          },
          {
            "line": 126,
            "text": "     AND zdaeh = 'Y'"
          },
          {
            "line": 127,
            "text": "     AND jorgeh_txt = ''."
          },
          {
            "line": 128,
            "text": "*     AND ( zsourflex <> 'T' OR zsourflex <> 'Z' ). \" 간주 기타"
          },
          {
            "line": 129,
            "text": ""
          },
          {
            "line": 130,
            "text": "\"20220615-나구엽-교대근무자들은 2023년 7월 쯤 보상휴가 정산 예정이라 일단 제외"
          },
          {
            "line": 131,
            "text": "* 교대 근무 보상 휴가 추가"
          },
          {
            "line": 132,
            "text": "ELSEIF rb4 = 'X'."
          }
        ]
      },
      {
        "start": 415,
        "end": 426,
        "lines": [
          {
            "line": 415,
            "text": "*      endif."
          },
          {
            "line": 416,
            "text": "    ENDIF."
          },
          {
            "line": 417,
            "text": ""
          },
          {
            "line": 418,
            "text": "     \"20260616-나구엽-인사부 요청. 부장급이면 금액 0원."
          },
          {
            "line": 419,
            "text": "     IF l_manager = 'M'."
          },
          {
            "line": 420,
            "text": "       gt_disp-zd_money  = 0."
          },
          {
            "line": 421,
            "text": "       gt_disp-zd_money_c = gt_disp-zd_money."
          },
          {
            "line": 422,
            "text": "       gt_disp-jorgeh = 0."
          },
          {
            "line": 423,
            "text": "       gt_disp-jorgeh_c = gt_disp-jorgeh."
          },
          {
            "line": 424,
            "text": "     ELSE."
          },
          {
            "line": 425,
            "text": "       gt_disp-zd_money_c = gt_disp-zd_money / 100.  \"추가 - 2019.06.27 by chl"
          },
          {
            "line": 426,
            "text": "       gt_disp-jorgeh_c = gt_disp-jorgeh / 100.  \"추가 - 2019.06.27 by chl"
          }
        ]
      },
      {
        "start": 515,
        "end": 541,
        "lines": [
          {
            "line": 515,
            "text": "                                       binary search."
          },
          {
            "line": 516,
            "text": "        if sy-subrc = 0."
          },
          {
            "line": 517,
            "text": "          IF ls_tmp-zgubun IS NOT INITIAL"
          },
          {
            "line": 518,
            "text": "              OR ls_tmp-zsourflex = 'S'"
          },
          {
            "line": 519,
            "text": "              OR ls_tmp-zsourflex = 'X'.           \"통상, 선택, 탄력이면 *2"
          },
          {
            "line": 520,
            "text": "            IF ls_tmp-jorgeh IS INITIAL. \"휴일-휴일 인 경우 대휴 정산 금액이 시간외 저장 시 계산 해서 미리 넣어 놨음"
          },
          {
            "line": 521,
            "text": "               ls_tmp-jorgeh = ls_tmp-zd_money * 2."
          },
          {
            "line": 522,
            "text": "            ENDIF."
          },
          {
            "line": 523,
            "text": ""
          },
          {
            "line": 524,
            "text": "          ELSE."
          },
          {
            "line": 525,
            "text": "            ls_tmp-jorgeh = ls_tmp-zd_money."
          },
          {
            "line": 526,
            "text": "          ENDIF."
          },
          {
            "line": 527,
            "text": "        endif."
          },
          {
            "line": 528,
            "text": "        MODIFY lt_tmp FROM ls_tmp."
          },
          {
            "line": 529,
            "text": "      endloop."
          },
          {
            "line": 530,
            "text": "    else.  \"예외 아닌 사람."
          },
          {
            "line": 531,
            "text": "      LOOP AT lt_tmp INTO ls_tmp WHERE pernr = ls_cal-pernr."
          },
          {
            "line": 532,
            "text": "        lv_cnt = lv_cnt + 1."
          },
          {
            "line": 533,
            "text": "        ls_tmp-jorgeh_txt = 'Y'."
          },
          {
            "line": 534,
            "text": "        IF ls_cal-t_y < lv_cnt .  \"사용갯수 넘었다는건 보상해야 한다는 것."
          },
          {
            "line": 535,
            "text": "          IF ls_tmp-zgubun IS NOT INITIAL"
          },
          {
            "line": 536,
            "text": "              OR ls_tmp-zsourflex = 'S'"
          },
          {
            "line": 537,
            "text": "              OR ls_tmp-zsourflex = 'X'.           \"통상, 선택, 탄력이면 *2"
          },
          {
            "line": 538,
            "text": "            IF ls_tmp-jorgeh IS INITIAL. \"휴일-휴일 인 경우 대휴 정산 금액이 시간외 저장 시 계산 해서 미리 넣어 놨음"
          },
          {
            "line": 539,
            "text": "              ls_tmp-jorgeh = ls_tmp-zd_money * 2."
          },
          {
            "line": 540,
            "text": "            ENDIF."
          },
          {
            "line": 541,
            "text": "          ELSE."
          }
        ]
      }
